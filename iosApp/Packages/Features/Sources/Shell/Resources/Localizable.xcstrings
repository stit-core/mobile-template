{
  "sourceLanguage": "ru",
  "strings": {
    "shell.update_required.title": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нужно обновление"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Update required"
          }
        }
      }
    },
    "shell.update_required.body": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта версия больше не поддерживается. Обновите приложение, чтобы продолжить."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This version is no longer supported. Update the app to continue."
          }
        }
      }
    },
    "shell.update_required.action": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обновить"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Update"
          }
        }
      }
    },
    "shell.maintenance.title": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Технические работы"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenance"
          }
        }
      }
    },
    "shell.maintenance.body": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервис временно недоступен. Попробуйте позже."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The service is temporarily unavailable. Try again later."
          }
        }
      }
    },
    "shell.update_recommended.title": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступна новая версия"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A new version is available"
          }
        }
      }
    },
    "shell.update_recommended.action": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обновить"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Update"
          }
        }
      }
    },
    "shell.update_recommended.dismiss": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Позже"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Later"
          }
        }
      }
    },
    "common.retry": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Повторить"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retry"
          }
        }
      }
    }
  },
  "version": "1.0"
}
