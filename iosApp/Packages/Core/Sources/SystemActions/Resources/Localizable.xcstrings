{
  "sourceLanguage": "ru",
  "strings": {
    "action.add-todo.added": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавил: %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Added: %@"
          }
        }
      }
    },
    "action.add-todo.ask_text": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что записать?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What should I add?"
          }
        }
      }
    },
    "action.add-todo.description": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавляет задачу в список пользователя."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adds a task to the user's list."
          }
        }
      }
    },
    "action.add-todo.failed": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось добавить задачу. Попробуйте позже."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not add the task. Try again later."
          }
        }
      }
    },
    "action.add-todo.parameter.text": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Текст задачи"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Task text"
          }
        }
      }
    },
    "action.add-todo.signed_out": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Войдите в приложение, чтобы добавлять задачи."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to the app to add tasks."
          }
        }
      }
    },
    "action.add-todo.title": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавить задачу"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a task"
          }
        }
      }
    },
    "action.complete-todo.already_done": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уже отмечена: %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Already done: %@"
          }
        }
      }
    },
    "action.complete-todo.done": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отметил: %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Marked done: %@"
          }
        }
      }
    },
    "action.complete-todo.failed": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось отметить задачу. Откройте приложение и попробуйте снова."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not mark the task. Open the app and try again."
          }
        }
      }
    },
    "action.complete-todo.parameter.todo": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Задача"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Task"
          }
        }
      }
    },
    "action.complete-todo.signed_out": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Войдите, чтобы отмечать задачи."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to mark tasks as done."
          }
        }
      }
    },
    "action.complete-todo.title": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отметить задачу"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mark task done"
          }
        }
      }
    },
    "action.unavailable": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте приложение и попробуйте снова."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the app and try again."
          }
        }
