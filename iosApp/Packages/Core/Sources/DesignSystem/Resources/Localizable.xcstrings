{
  "sourceLanguage": "ru",
  "strings": {
    "error.network": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет соединения. Проверьте сеть и попробуйте снова."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No connection. Check your network and try again."
          }
        }
      }
    },
    "error.unknown": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что-то пошло не так. Попробуйте ещё раз."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something went wrong. Please try again."
          }
        }
      }
    },
    "error.validation": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверьте выделенные поля."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the highlighted fields."
          }
        }
      }
    },
    "error.auth_invalid_credentials": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Неверный email или пароль."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wrong email or password."
          }
        }
      }
    },
    "error.auth_refresh_expired": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сессия истекла. Войдите снова."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your session has expired. Sign in again."
          }
        }
      }
    },
    "error.auth_refresh_reused": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сессия завершена на другом устройстве. Войдите снова."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your session was ended on another device. Sign in again."
          }
        }
      }
    },
    "error.auth_account_locked": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Аккаунт заблокирован. Обратитесь в поддержку."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This account is locked. Contact support."
          }
        }
      }
    },
    "error.rate_limited": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слишком много запросов. Попробуйте через минуту."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many requests. Try again in a minute."
          }
        }
      }
    },
    "error.internal": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ошибка сервера. Попробуйте позже."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Server error. Try again later."
          }
        }
      }
    },
    "common.retry": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Повторить"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retry"
          }
        }
      }
    },
    "common.offline": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет сети — показаны сохранённые данные"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline — showing saved data"
          }
        }
      }
    }
  },
  "version": "1.0"
}
