// Общие настройки сборки; per-env значения — Dev/Staging/Prod/Demo.xcconfig. Ключи конфига = config/env/*.properties.
IPHONEOS_DEPLOYMENT_TARGET = 18.0
TARGETED_DEVICE_FAMILY = 1,2
SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
SWIFT_APPROACHABLE_CONCURRENCY = YES
SWIFT_DEFAULT_ACTOR_ISOLATION = MainActor
SWIFT_TREAT_WARNINGS_AS_ERRORS = YES
GCC_TREAT_WARNINGS_AS_ERRORS = YES
SWIFT_UPCOMING_FEATURE_EXISTENTIAL_ANY = YES
SWIFT_UPCOMING_FEATURE_MEMBER_IMPORT_VISIBILITY = YES
SWIFT_UPCOMING_FEATURE_INTERNAL_IMPORTS_BY_DEFAULT = YES
DEAD_CODE_STRIPPING = YES
// Фаза scripts/embed-shared.sh пишет Shared.framework в продукты сборки — под песочницей скриптов Xcode это запрещено.
ENABLE_USER_SCRIPT_SANDBOXING = NO
FRAMEWORK_SEARCH_PATHS = $(inherited) $(SRCROOT)/../shared/build/xcode-frameworks/$(CONFIGURATION)/$(SDK_NAME)
CODE_SIGN_ENTITLEMENTS = App/App.entitlements

// Версия задаётся релизом из тега (scripts/tools/version-from-tag.sh); dev-сборки — 0.0.0 / 1.
MARKETING_VERSION = 0.0.0
CURRENT_PROJECT_VERSION = 1

APP_NAME = Stit
BUNDLE_ID = tech.stit.mobile$(BUNDLE_ID_SUFFIX)
PRODUCT_BUNDLE_IDENTIFIER = $(BUNDLE_ID)
DEEP_LINK_SCHEME = stit
AUTH_MODE = bearer

// TEAM_ID и локальные переопределения — Local.xcconfig (gitignored, образец Local.xcconfig.example); включается последним, чтобы побеждать.
#include? "Local.xcconfig"
