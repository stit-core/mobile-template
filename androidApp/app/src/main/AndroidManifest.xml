<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Сеть — shared (OkHttp); остальные разрешения объявляют модули core:platform, которые их используют. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".StitApplication"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Stit"
        tools:targetApi="tiramisu">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Stit">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- App Links: хост и пути — из docs/stack/deep-links.md, значение хоста — config/env (DEEP_LINK_HOST). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="${DEEP_LINK_HOST}" />
                <data android:path="/" />
                <data android:pathPrefix="/login" />
                <data android:pathPrefix="/profile" />
                <data android:pathPrefix="/settings" />
                <data android:pathPrefix="/todos" />
            </intent-filter>
            <!-- Custom scheme — fallback для писем и QR; в push и вебе только https. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${DEEP_LINK_SCHEME}" />
            </intent-filter>
        </activity>
        <!-- Per-app locale ниже API 33: AppCompat хранит выбор языка сам (autoStoreLocales). -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>
    </application>

</manifest>
