{
  "color": {
    "$type": "color",
    "app": {
      "bg": { "$value": { "light": "#FFFFFF", "dark": "#121212" } },
      "fg": { "$value": { "light": "#1A1A1A", "dark": "#ECECEC" } }
    },
    "surface": {
      "muted": { "$value": { "light": "#F2F2F2", "dark": "#1E1E1E" } }
    },
    "divider": { "$value": { "light": "#E0E0E0", "dark": "#2E2E2E" } },
    "action": {
      "bg": { "$value": { "light": "#1B5E20", "dark": "#81C784" } },
      "fg": { "$value": { "light": "#FFFFFF", "dark": "#0B2E10" } }
    },
    "danger": { "$value": { "light": "#B3261E", "dark": "#F2B8B5" } },
    "success": { "$value": { "light": "#1B7F3B", "dark": "#6ED08C" } },
    "warning": { "$value": { "light": "#8A5200", "dark": "#FFC46B" } },
    "muted": { "$value": { "light": "#6B6B6B", "dark": "#9A9A9A" } }
  },
  "dimension": {
    "$type": "dimension",
    "space": {
      "xs": { "$value": "4dp" },
      "sm": { "$value": "8dp" },
      "md": { "$value": "16dp" },
      "lg": { "$value": "24dp" },
      "xl": { "$value": "32dp" }
    },
    "radius": {
      "control": { "$value": "12dp" },
      "card": { "$value": "16dp" }
    },
    "touch": {
      "min": { "$value": "48dp" }
    }
  },
  "typography": {
    "$type": "dimension",
    "body": {
      "sm": { "$value": "14sp" },
      "md": { "$value": "16sp" }
    },
    "heading": {
      "lg": { "$value": "22sp" }
    }
  }
}
